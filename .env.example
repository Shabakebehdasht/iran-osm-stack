# Password for the Nominatim database role.
#
# The role is created with this value DURING the first import, so it must
# exist before `docker compose up -d`. After that it cannot be changed without
# a full re-import — the database will simply refuse the connection.
#
# Generate one:
#     echo "NOMINATIM_PASSWORD=$(openssl rand -hex 16)" > .env
#     chmod 600 .env
#
# Compose refuses to start without it (the ${NOMINATIM_PASSWORD:?...} guard in
# docker-compose.yml), which is intentional: a missing value must stop the
# import rather than fall back to a publicly known default.
#
# This file must never be committed.
NOMINATIM_PASSWORD=

# Shared secret required by the access gateway on every tile / geocoding /
# routing request, as ?key=<value>. Without it the gateway answers 403.
#
# Generate one:
#     echo "OSM_ACCESS_KEY=$(openssl rand -hex 32)" >> .env
#
# Changing it later is safe and instant — it only affects the gateway, no
# re-import is involved. You then update the three URLs in h-dashboard's .env
# to match.
#
# This value ends up in page HTML and in browser history, so it stops
# accidental use and casual scanning, not a determined reader. See the
# "Access control" section of the README.
OSM_ACCESS_KEY=